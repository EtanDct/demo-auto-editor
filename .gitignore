# Media (heavy files, never committed)
input/*
!input/.gitkeep
output/*
!output/.gitkeep
audio/*
!audio/.gitkeep
!audio/narration
audio/narration/*
!audio/narration/.gitkeep
frames/*
!frames/.gitkeep
overlays/*
!overlays/.gitkeep
logs/*
!logs/.gitkeep
*.mp4
*.mov
*.wav
*.srt
*.vtt

# data/ : uniquement le glossaire est du contenu source ; le reste
# (transcript, conducteur de montage, timeline, sous-titres...) est généré
# par le pipeline à partir d'une vidéo donnée.
data/*
!data/.gitkeep
!data/glossary.yaml

# Models (downloaded on demand, see scripts/download_models.py)
models/

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Env / secrets
.env

# OS
.DS_Store
Thumbs.db
